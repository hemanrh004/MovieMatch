        {
          "name": "Register (user A)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.data && j.data.token) { pm.collectionVariables.set('token', j.data.token); pm.collectionVariables.set('myId', j.data.user._id); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
