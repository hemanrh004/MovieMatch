# Browser-safe values (VITE_ prefix = public)
VITE_API_BASE_URL=http://localhost:5000/api          # empty = dev proxy at /tmdb; later: https://your-api.com/api/tmdb
VITE_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
VITE_AI_API_URL=              # later: https://your-api.com/api/ai
VITE_SOCKET_URL=http://localhost:5000         # later: https://your-api.com
# Server-side only (NO VITE_ prefix). Get it at themoviedb.org > Settings > API > "API Read Access Token"
TMDB_READ_TOKEN=
